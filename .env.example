# =============================================
# BACKEND ENVIRONMENT VARIABLES
# =============================================

# Django Secret Key (generate a strong random key for production)
SECRET_KEY=your-very-secret-django-key-here

# Debug mode (set to False in production)
DEBUG=True

# Supabase PostgreSQL Connection
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your-supabase-db-password
DATABASE_HOST=db.vbufzyabuqubqxcfjwyh.supabase.co
DATABASE_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-domain.com

# CORS Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# JWT Settings (optional overrides)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================
# FRONTEND ENVIRONMENT VARIABLES
# =============================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# =============================================
# NOTES
# =============================================
# - Never commit actual .env files to git
# - The Supabase password is obtained from:
#   Supabase Dashboard → Project Settings → Database
# - Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (Django)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe backend/manage.py runserver 0.0.0.0:8000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting development server",
          "endsPattern": "Quit the server with"
        }
      },
      "presentation": {
        "group": "servers",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Start Frontend (Vite React)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "group": "servers",
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Run Full Stack Project (Backend + Frontend)",
      "dependsOn": [
        "Start Backend (Django)",
        "Start Frontend (Vite React)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Database Migrations",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe backend/manage.py migrate",
      "problemMatcher": []
    },
    {
      "label": "Run Pytest Test Suite",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest backend/tests",
      "problemMatcher": []
    }
  ]
}
